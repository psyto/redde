<?xml version="1.0" encoding="UTF-8"?>
<!-- Always-on Campana keeper. Load once; launchd keeps `keeper.mjs --loop` alive across reboots and
     crashes, so the canonical status account is re-cranked at every OPEN<->CLOSED flip.
       cp com.psyto.campana-keeper.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.psyto.campana-keeper.plist
       launchctl kickstart -k gui/$UID/com.psyto.campana-keeper                  # start now
       launchctl bootout   gui/$UID/com.psyto.campana-keeper                     # stop
     Verify it is RUNNING, not merely loaded: `launchctl print gui/$UID/com.psyto.campana-keeper`
     must show `runs` above 0, and /tmp/campana-keeper.log must contain crank lines. Legacy
     `launchctl load` registers the job on current macOS without honouring RunAtLoad — it reports
     nothing, `launchctl list` shows the label, and the keeper never starts.
     Edit the paths below if your node / repo / keypair live elsewhere. Uses devnet by default.

     The node path is ABSOLUTE and deliberate. launchd starts with its own minimal PATH, which on
     this machine reaches a 2023-vintage /usr/local/bin/node (v18) that hangs on this script rather
     than failing — and KeepAlive would then restart it forever, so the keeper would look loaded
     while never once cranking. keeper.mjs now refuses to run on node < 20, so that failure is at
     least loud; keep this path current when you upgrade node. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.psyto.campana-keeper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/hiroyusai/.nvm/versions/node/v24.0.1/bin/node</string>
    <string>keeper.mjs</string>
    <string>--loop</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/hiroyusai/src/redde/surfaces/vesper/campana-program</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/campana-keeper.log</string>
  <key>StandardErrorPath</key><string>/tmp/campana-keeper.err</string>
</dict>
</plist>
